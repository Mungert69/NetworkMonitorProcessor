<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0-android</TargetFramework>
    <RootNamespace>NetworkMonitor.Processor</RootNamespace>
            
    <Nullable>enable</Nullable>
      <DefineConstants>NetworkMonitorProcessor</DefineConstants>
      <!-- Ensure all assemblies are copied to the output directory -->
      <AndroidSdkDirectory>/usr/lib/android-sdk</AndroidSdkDirectory>
              
  </PropertyGroup>


<PropertyGroup>
  <DefaultItemExcludes>$(DefaultItemExcludes);openssl\**\*</DefaultItemExcludes>
</PropertyGroup>



  <ItemGroup>
     <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetworkMonitorLib\NetworkMonitor-Maui-Android.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AndroidNativeLibrary Remove="docker-context/**" />
    <Content Remove="docker-context/**" />
    <None Remove="docker-context/**" />
    <MauiAsset Remove="docker-context/**" />
  </ItemGroup>
   
</Project>
