<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net9.0-android35.0</TargetFramework>
    <RootNamespace>NetworkMonitor.Processor</RootNamespace>
            
    <Nullable>enable</Nullable>
      <DefineConstants>NetworkMonitorProcessor</DefineConstants>
      <!-- Ensure all assemblies are copied to the output directory -->
      <AndroidSdkDirectory>/usr/lib/android-sdk</AndroidSdkDirectory>
              
  </PropertyGroup>


<PropertyGroup>
  <DefaultItemExcludes>$(DefaultItemExcludes);openssl\**\*</DefaultItemExcludes>
</PropertyGroup>



  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.9" />
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.9.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.13.1.4" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.8.4.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.8.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetworkMonitorLib\NetworkMonitor-Maui-Android.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AndroidNativeLibrary Remove="docker-context/**" />
    <Content Remove="docker-context/**" />
    <None Remove="docker-context/**" />
    <MauiAsset Remove="docker-context/**" />
  </ItemGroup>
   
</Project>
