# Debian 13 (trixie) runtime only
FROM debian:trixie-slim

ENV DOTNET_RUNNING_IN_CONTAINER=true
# Create fixed UID/GID runtime user
RUN groupadd -g 1654 appuser && \
    useradd -u 1654 -g 1654 -M -s /usr/sbin/nologin appuser
RUN mkdir -p /home/appuser && chown -R appuser:appuser /home/appuser
ENV HOME=/home/appuser

# ---- Parameters (overridable at build) ----
# Which Debian feed to use for Microsoft's repo (stick to 12 while 13 isn't populated)
ARG DOTNET_DEBIAN_FEED=12
# Which .NET runtime package to install (aspnetcore runtime includes Microsoft.AspNetCore.App)
ARG DOTNET_PACKAGE=dotnet-runtime-9.0


# OS deps: .NET runtime + Chromium/Puppeteer shared libs + xvfb + xauth + bash
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        wget curl gnupg ca-certificates \
        bash \
        libcap2-bin gosu nmap \
        # Chromium/Puppeteer runtime deps
        libasound2 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libc6 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libexpat1 \
        libfontconfig1 \
        libgcc-s1 \
        libgdk-pixbuf-2.0-0 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libpangoft2-1.0-0 \
        libstdc++6 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxrandr2 \
        libxrender1 \
        libxss1 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libgbm1 \
        libvulkan1 \
        fonts-liberation \
        xdg-utils \
        # headless display
        xvfb \
        xauth \
    ; \
    # Microsoft repo (explicitly use Debian ${DOTNET_DEBIAN_FEED})
    wget https://packages.microsoft.com/config/debian/${DOTNET_DEBIAN_FEED}/packages-microsoft-prod.deb -O /tmp/packages-microsoft-prod.deb; \
    dpkg -i /tmp/packages-microsoft-prod.deb; \
    rm /tmp/packages-microsoft-prod.deb; \
    apt-get update; \
    # Install the chosen .NET runtime package (default: aspnetcore-runtime-9.0)
    apt-get install -y --no-install-recommends ${DOTNET_PACKAGE}; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY docker-context/publish/ ./

# Mirror system nmap into expected app tree + NSE assets
RUN mkdir -p /app/openssl/bin && \
    ln -sf /usr/bin/nmap /app/openssl/bin/nmap && \
    ln -sf /usr/share/nmap/nse_main.lua /app/openssl/bin/nse_main.lua && \
    ln -s /usr/share/nmap/scripts /app/openssl/bin/scripts && \
    ln -s /usr/share/nmap/nselib  /app/openssl/bin/nselib

# Ensure entrypoint is executable
RUN if [ -f /app/entrypoint.sh ]; then \
      sed -i 's/\r$//' /app/entrypoint.sh && \
      chmod +x /app/entrypoint.sh; \
    fi

# Start as root; entrypoint drops to appuser with ambient caps
USER root
ENTRYPOINT ["/app/entrypoint.sh"]

