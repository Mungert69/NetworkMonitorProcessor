docker push "$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG"  # Push the "tag" tag


## start second stage build for metasploit image


# Resolve the digest of the base you just pushed
BASE_REF="$(docker inspect --format='{{index .RepoDigests 0}}' "$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG")"

# Build the Metasploit image from the exact base digest
docker build --progress=plain \
  -f Dockerfile.msf \
  --build-arg BASE_IMAGE="$BASE_REF" \
  -t "$DOCKER_IMAGE_NAME:latest" . 2>&1 | tee "$LOG_DIR/msf.build.log"

docker push "$DOCKER_IMAGE_NAME:latest"

