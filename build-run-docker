#!/bin/sh
set -euo pipefail

# --- config ---
PROJECT="NetworkMonitorProcessor-debian12.csproj"
DOCKERFILE="Dockerfile.trixie"
DOCKER_COMPOSE_FILE="$HOME/code/NetworkMonitor/docker-compose-run-processor.yml"
CONTAINER_NAME="processor"

# --- cleanup BEFORE tests (prevents duplicate types from stale publish) ---
[ -d "./publish" ] && rm -rf ./publish
find ./openssl/bin -type f -name '*.cs' -delete 2>/dev/null || true

# optional secrets/appsettings
SECRET_FILE="../secret"
[ -f "appsettings-live.json" ] && cp appsettings-live.json appsettings.json || echo "⚠ appsettings-live.json not found (skipping copy)."
[ -f "$SECRET_FILE" ] || echo "⚠ $SECRET_FILE not found (continuing without REPO_URL)."

# image name/tag from compose
DOCKER_IMAGE_FULL=$(grep -m1 'image:' "$DOCKER_COMPOSE_FILE" | awk '{ print $2 }')
DOCKER_IMAGE_NAME=$(echo "$DOCKER_IMAGE_FULL" | cut -d':' -f1)
DOCKER_IMAGE_TAG=$(echo "$DOCKER_IMAGE_FULL" | cut -d':' -f2)
echo "Docker Image Full is $DOCKER_IMAGE_FULL . Name is $DOCKER_IMAGE_NAME ."

# --- tests ---
dotnet test "$PROJECT"

# --- publish on host (outside project tree) ---
ARTIFACTS_DIR="../_artifacts/processor"
PUBLISH_DIR="$ARTIFACTS_DIR/publish"
rm -rf "$PUBLISH_DIR"
mkdir -p "$PUBLISH_DIR"
dotnet publish "$PROJECT" -c Release -o "$PUBLISH_DIR" --os linux --arch x64

# --- stage into docker build context (so COPY is allowed) ---
STAGING_DIR="./docker-context/publish"
rm -rf "./docker-context"
mkdir -p "$STAGING_DIR"
cp -a "$PUBLISH_DIR/." "$STAGING_DIR/"

# --- build docker image (Debian 13 runtime + .NET runtime from Debian 12 repo) ---
docker build -f "$DOCKERFILE" -t "$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG" .

# --- run via compose ---
docker compose -f "$DOCKER_COMPOSE_FILE" up -d

echo "Waiting for the container to be ready..."
until docker exec -it "$CONTAINER_NAME" bash -c "ls /app" >/dev/null 2>&1; do
  sleep 2
done
docker exec -it "$CONTAINER_NAME" bash -c "
set -e
apt-get -y update && apt-get -y upgrade && apt-get -y install \
  curl xvfb \
  libatk1.0-0 \
  libatk-bridge2.0-0 \
  libcups2 \
  libxcomposite1 \
  libxrandr2 \
  libxdamage1 \
  libxkbcommon-x11-0 \
  libgbm1 \
  libasound2 \
  libnss3 \
  libgdk-pixbuf-2.0-0 \
  libpango-1.0-0 \
  libpangoft2-1.0-0 \
  libpangocairo-1.0-0
"


