'


# Step 9: Install Metasploit from GitHub, and add auto-update script
docker exec -it "$CONTAINER_NAME" bash -c '
set -e

# Install dependencies for Metasploit from source
apt-get -y update && apt-get install -y \
  autoconf bison build-essential libssl-dev libyaml-dev \
  libreadline-dev zlib1g-dev libgmp-dev libpcap-dev \
  libsqlite3-dev libxml2-dev libxslt1-dev libtool \
  libffi-dev git gnupg2 libpq-dev ruby ruby-dev liblzma-dev

#
# Clone Metasploit Framework
git clone --depth 1 https://github.com/rapid7/metasploit-framework /opt/metasploit-framework
cd /opt/metasploit-framework

# Install Ruby gems
# Install Ruby gems (make sure xmlrpc is available first)
gem install bundler:2.5.11
gem install xmlrpc -v 0.3.3

bundle config set --local without "development test"
bundle install || bundle update --bundler

# Symlink for easy access
ln -s /opt/metasploit-framework/msfconsole /usr/local/bin/msfconsole
ln -s /opt/metasploit-framework/msfupdate /usr/local/bin/msfupdate
ln -s /opt/metasploit-framework/msfvenom /usr/local/bin/msfvenom
ln -s /opt/metasploit-framework/msfdb /usr/local/bin/msfdb
ln -s /opt/metasploit-framework/msfrpc /usr/local/bin/msfrpc
ln -s /opt/metasploit-framework/msfrpcd /usr/local/bin/msfrpcd
ln -s /opt/metasploit-framework/msfd /usr/local/bin/msfd

# Add msfupdate-if-due script to cron.daily (no cron install needed)
mkdir -p /var/lib /var/log
cat << "EOF" > /etc/cron.daily/msfupdate-if-due
#!/bin/bash

STAMP_FILE="/var/lib/msfupdate-last-run"
NOW=$(date +%s)

if [ ! -f "$STAMP_FILE" ] || [ $((NOW - $(cat "$STAMP_FILE"))) -ge 864000 ]; then
  echo "[$(date)] Running msfupdate (git pull)..." >> /var/log/msfupdate.log
  cd /opt/metasploit-framework
  git pull >> /var/log/msfupdate.log 2>&1
  bundle install >> /var/log/msfupdate.log 2>&1
  date +%s > "$STAMP_FILE"
else
  echo "[$(date)] Skipping msfupdate, not due yet." >> /var/log/msfupdate.log
fi
EOF
chmod +x /etc/cron.daily/msfupdate-if-due

# ✅ Ensure appuser owns Metasploit so msfupdate can run without root
chown -R appuser:appuser /opt/metasploit-framework
chown -R appuser:appuser /var/lib /var/log

'
# Step 10: Final cleanup before image commit
docker exec -it "$CONTAINER_NAME" bash -c '
set -e

echo "🧹 Final cleanup before image commit..."

# Purge all development headers and tools
apt purge -y  "build-essential" "bison" "autoconf" "flex"

# Autoremove unneeded deps
apt autoremove -y

# Remove APT cache and orphaned packages
apt clean
rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.cache /root/.npm

# Remove Gem docs, man pages, and info pages
rm -rf /opt/metasploit-framework/doc /usr/share/doc /usr/share/man /usr/share/info

# Zero out logs
truncate -s 0 /var/log/msfupdate.log || true

echo "✅ Library and system cleanup complete."
'

# Step 12: Commit full build as latest tag
docker commit  "$CONTAINER_NAME" "$DOCKER_IMAGE_NAME:latest"  # Commit to "latest"
docker push "$DOCKER_IMAGE_NAME:latest"  # Push the "latest" tag

# Step 13: Confirm completion
echo "The container is running, and the extra commands have been executed. Image has been pushed to Docker Hub as $DOCKER_IMAGE_FULL and $DOCKER_IMAGE_NAME:latest."

# Step 14: Stop the container using Docker Compose
if ! docker compose -f "$DOCKER_COMPOSE_FILE" down; then
    echo "Failed to stop the container using Docker Compose. Exiting..."
    exit 1
fi

