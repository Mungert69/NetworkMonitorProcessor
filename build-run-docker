# Step 8: Push both the standard bug version tag
docker commit  "$CONTAINER_NAME" "$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG"  # Commit to "tag"
docker push "$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG"  # Push the "tag" tag

docker exec -e DEBIAN_FRONTEND=noninteractive -it "$CONTAINER_NAME" bash -c '
set -e
apt-get update -y
apt-get install -y --no-install-recommends \
  gnupg \
  curl \
