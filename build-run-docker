# Step 7: Clean up unnecessary build tools and libraries
docker exec -it "$CONTAINER_NAME" bash -c '
set -e

apt install nmap
ln -s /usr/bin/nmap nmap
cp /usr/share/nmap/nse_main.lua /app/openssl/bin/nse_main.lua
echo "🧹 Cleaning up build tools and dev packages..."

# Remove build-time packages
apt purge -y \
  build-essential 

# Autoremove any unneeded dependencies
apt autoremove -y

# Clean APT cache
rm -rf /var/lib/apt/lists/*

# Remove any temp build files or unnecessary leftovers
rm -rf /tmp/nmap-* /tmp/nmap-*.tar.bz2 /root/.cache /root/.npm || true

echo "✅ Clean-up complete. Final disk usage:"
du -sh /usr/local/bin/nmap
'

# Step 8: Push both the standard bug version tag
docker commit  "$CONTAINER_NAME" "$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG"  # Commit to "tag"
docker push "$DOCKER_IMAGE_NAME:$DOCKER_IMAGE_TAG"  # Push the "tag" tag

# Step 9: Update and install all required packages for full build.
