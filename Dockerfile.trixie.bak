# Debian 13 (trixie) runtime only
FROM debian:trixie-slim
RUN groupadd -g 1654 appuser && \
    useradd -u 1654 -g 1654 -M -s /usr/sbin/nologin appuser

# Install .NET runtime, nmap, gosu, and tools we need
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        wget curl gnupg ca-certificates \
        libcap2-bin \
        nmap \
        gosu; \
    wget https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -O /tmp/packages-microsoft-prod.deb; \
    dpkg -i /tmp/packages-microsoft-prod.deb; \
    rm /tmp/packages-microsoft-prod.deb; \
    apt-get update; \
    apt-get install -y --no-install-recommends dotnet-runtime-9.0; \
    rm -rf /var/lib/apt/lists/*

# We intentionally DO NOT setcap the dotnet binary (avoids EPERM on exec).
# nmap can work via ambient caps; no setcap needed either.

WORKDIR /app
COPY docker-context/publish/ ./

# Mirror system nmap into expected app tree + NSE assets
RUN mkdir -p /app/openssl/bin/scripts /app/openssl/bin/nselib && \
    ln -sf /usr/bin/nmap /app/openssl/bin/nmap && \
    cp -f /usr/share/nmap/nse_main.lua /app/openssl/bin/nse_main.lua && \
    cp -rf /usr/share/nmap/scripts/* /app/openssl/bin/scripts/ && \
    cp -rf /usr/share/nmap/nselib/* /app/openssl/bin/nselib/

# Ensure entrypoint is executable
RUN if [ -f /app/entrypoint.sh ]; then \
      sed -i 's/\r$//' /app/entrypoint.sh && \
      chmod +x /app/entrypoint.sh; \
    fi

# Start as root; entrypoint will drop to UID 1654 with ambient caps
USER root
ENTRYPOINT ["/app/entrypoint.sh"]

