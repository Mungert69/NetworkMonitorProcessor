#!/bin/bash
set -e

# Force overwrite of the key file without prompting
KEY_FILE="/usr/share/keyrings/metasploit-framework.gpg"
KEY_URL="https://apt.metasploit.com/metasploit-framework.gpg"

if [ -f "$KEY_FILE" ]; then
    echo "Overwriting existing GPG key..."
    curl -fsSL "$KEY_URL" -o "$KEY_FILE"
else
    echo "Downloading new GPG key..."
    curl -fsSL "$KEY_URL" -o "$KEY_FILE"
fi

# Ensure apt repo is added (only once)
echo "deb [signed-by=$KEY_FILE] https://apt.metasploit.com/ buster main" | tee /etc/apt/sources.list.d/metasploit-framework.list > /dev/null

# Update and install metasploit-framework silently
apt-get update -qq
apt-get install -qq -y metasploit-framework

